# Copy this file to .env and fill with your Supabase project values.
# Found in: Supabase Dashboard -> Settings -> API

# Project URL, e.g. https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe to expose in the client). Starts with "sb_publishable_" or "eyJ..."
EXPO_PUBLIC_SUPABASE_ANON_KEY=
